# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Secrets
secrets.toml
.env
*.key
*.pem

# Knowledge base holds user-supplied documents; keep the folder, never the contents
# Documents are the user's own; the folder ships empty
app/kb/*
!app/kb/.gitkeep

# Logs
*.log
logs/

# Cache
.cache/
*.pkl
*.pickle
embeddings_cache.pkl

# Testing
.pytest_cache/
.coverage
htmlcov/

# Redis
dump.rdb

# The FAISS index and its sidecar. A named Docker volume holds these normally, but a
# bare-metal run writes them under the repository.
data/
app/data/
*.faiss

# Temporary files
*.tmp
temp/
tmp/

# Local compose overrides (host-specific port conflicts, dev flags)
docker-compose.override.yml
.ipynb_checkpoints/
