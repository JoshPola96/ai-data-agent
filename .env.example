# =========================
# API Keys (Placeholders)
# =========================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# =========================
# Model Caching
# =========================
HF_HOME=/app/.cache/huggingface
MODEL_CACHE_DIR=/app/model_cache

# =========================
# Infrastructure
# =========================
# Use 'redis' as host when running inside Docker Compose
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
DEBUG_MODE=True

# =========================
# LLM Configuration
# =========================
DEFAULT_MODEL=gemini:gemini-2.5-flash
FALLBACK_MODEL=gemini:gemini-flash-latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
AGENT_MAX_TURNS=10

# Transient-fault retry before failing over to the other provider
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0

# =========================
# RAG Configuration
# =========================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Multi-Query Expansion (total phrasings searched, including the original)
USE_MULTI_QUERY=true
NUM_QUERY_VARIANTS=3

# =========================
# Chunking Strategy
# =========================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# =========================
# Retrieval Parameters
# =========================

# Multi-document support
MAX_DOCUMENTS_PER_SESSION=50
DOCUMENT_INDEX_TTL=3600  # 1 hours

RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=25


# =========================
# Reranking
# =========================
USE_RERANKING=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_THRESHOLD=0.35

# =========================
# Hybrid Search Weights
# =========================
BM25_WEIGHT=0.3
SEMANTIC_WEIGHT=0.7
RRF_K=60

# =========================
# Session & Storage
# =========================
SESSION_TTL=3600
MAX_CHAT_HISTORY=10
MAX_FILE_SIZE_MB=50

# =========================
# Auto-ingestion
# =========================
KB_FOLDER=/app/kb
AUTO_INGEST_ON_STARTUP=true

# =========================
# Data Processing (Single-line JSON lists)
# =========================
FORCE_STRING_COLUMNS=["id", "code", "reference", "employee_code"]
NUMERIC_CONVERSION_THRESHOLD=0.7
DATE_FORMATS=["%Y-%m-%d", "%d-%m-%Y", "%m-%d-%Y", "%Y/%m/%d", "%d/%m/%Y", "%m/%d/%Y", "%d.%m.%Y", "%Y.%m.%d", "%b-%y", "%B %Y"]

# =========================
# Performance
# =========================
MAX_CONCURRENT_TASKS=10