# =====================================================================
# API Keys — at least one is required
# =====================================================================
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here

# =====================================================================
# Hardware
# =====================================================================
# Docker cannot detect a GPU for you: a device must be requested, and requesting one
# that does not exist fails the container. 0 runs anywhere; set 1 if you have an
# NVIDIA GPU and the container toolkit. The app then auto-detects CUDA or CPU.
GPU_COUNT=0

# Half precision halves resident model size (~4GB to ~2.7GB) and is faster on Ampere
# or later. Ignored on CPU, where it is emulated and slower.
USE_FP16_ON_GPU=true

# One model call at a time. The embedder and reranker are ~2GB each, so on a 4GB card
# concurrent calls evict each other: a 0.05s reranker batch became 50-100s under
# five-way concurrency. Raise only on a card that fits both with headroom.
INFERENCE_CONCURRENCY=1

# =====================================================================
# LLM
# =====================================================================
# "gemini:" prefix routes to Google; anything else goes to OpenAI.
# Reasoning-grade alternatives for harder analysis:
#   DEFAULT_MODEL=gemini:gemini-3.1-pro-preview
#   DEFAULT_MODEL=gpt-5.2
DEFAULT_MODEL=gemini:gemini-3.6-flash
# Point this at the *other* provider. Failover is one hop, so a fallback sharing the
# primary's key inherits its quota and outage, and both halves fall together. With only
# one provider's key, prefer FALLBACK_MODEL=none: a refusal that names the reason beats a
# second doomed call.
FALLBACK_MODEL=gpt-5-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192
AGENT_MAX_TURNS=10

# The allow-list both endpoints validate against, so a typo is rejected rather than
# quietly answered by the fallback. Routing is by prefix — "gemini:" to Google, anything
# else to OpenAI — so any model either provider offers works once its name is listed here.
# DEFAULT_MODEL and FALLBACK_MODEL must appear in the list. Left commented so the shipped
# list stays in one place; uncomment to add your own.
# SUPPORTED_MODELS=["gemini:gemini-3.1-pro-preview","gpt-5.2","gemini:gemini-3.6-flash"]

# Transient faults (429, 503, timeouts) retried with backoff before failing over.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0

# =====================================================================
# Embedding and reranking
# =====================================================================
# BAAI/bge-m3 covers 100+ languages, so a question in one language retrieves
# passages written in another. EMBEDDING_DIM must match the model.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

USE_RERANKING=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_THRESHOLD=0.35

# English-only alternative, ~440MB instead of ~2.2GB:
#   EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
#   EMBEDDING_DIM=768
#   RERANKER_MODEL=BAAI/bge-reranker-base

# =====================================================================
# Retrieval
# =====================================================================
# Query expansion costs one extra LLM call per question; disabling it is the single
# biggest cost saving.
USE_MULTI_QUERY=true
NUM_QUERY_VARIANTS=3

RETRIEVAL_CANDIDATES=25
RETRIEVAL_TOP_K=5

# Lexical vs semantic weighting during fusion. Raise BM25 for codes and part numbers,
# raise semantic for conceptual and cross-language questions.
BM25_WEIGHT=0.3
SEMANTIC_WEIGHT=0.7
RRF_K=60

# =====================================================================
# Chunking
# =====================================================================
# Overlap carries context across a split so a sentence cut in half stays findable.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# =====================================================================
# Sessions and storage
# =====================================================================
SESSION_TTL=3600
MAX_CHAT_HISTORY=20
MAX_FILE_SIZE_MB=50
MAX_DOCUMENTS_PER_SESSION=50
DOCUMENT_INDEX_TTL=3600

# The index is written here and restored at startup so uploads survive a restart.
# Mount it on durable storage in anything long-lived.
PERSIST_INDEX=true
INDEX_DIR=/app/data/index

# =====================================================================
# Knowledge base
# =====================================================================
# Files in this folder are ingested at startup and retrievable by every session.
KB_FOLDER=/app/kb
AUTO_INGEST_ON_STARTUP=true
KB_SESSION_ID=kb_default

# =====================================================================
# Request limits
# =====================================================================
# Bounds on untrusted input. session_id is interpolated into Redis keys, so its
# charset is restricted in the request schema as well.
MAX_QUERY_CHARS=4000
MAX_SESSION_ID_CHARS=64
MAX_CUSTOM_DATA_ROWS=5000

# =====================================================================
# Infrastructure
# =====================================================================
# Compose overrides REDIS_URL to redis://redis:6379/0 for the container network.
REDIS_URL=redis://localhost:6379/0

# Wildcard origins are invalid alongside credentials; list the frontend explicitly.
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

LOG_LEVEL=INFO
# Debug logging includes document content and tool arguments — off in anything shared.
DEBUG_MODE=false

# =====================================================================
# Data processing
# =====================================================================
# Name tokens marking a column as an identifier, not a measure. Matched as whole
# underscore-separated parts, so "id" catches customer_id and leaves notes alone. Columns
# whose values are zero-padded (00067) are detected without being listed.
FORCE_STRING_COLUMNS=["id","code","ref","reference","sku","employee_code"]
NUMERIC_CONVERSION_THRESHOLD=0.7
MAX_CONCURRENT_TASKS=10

# Formats tried when a column looks like dates. Add yours if a date column is being read
# as text — day-first and month-first are both already covered.
# DATE_FORMATS=["%Y-%m-%d","%d/%m/%Y","%b-%y"]

# =====================================================================
# Model cache paths — set by the image, override only deliberately
# =====================================================================
# Both point inside the container, where the build already placed ~6.5GB of weights.
# Repointing them sends the app looking in an empty directory, and it will download the
# models again at startup.
# HF_HOME=/app/.cache/huggingface
# MODEL_CACHE_DIR=/app/model_cache
